import datetime
import matplotlib.pyplot as plt
import pandas as pd
import streamlit as st

# 페이지 설정
st.set_page_config(
    page_title="월별 기온 분석 대시보드", page_icon="🌡️", layout="wide"
)

st.title("🌡️ 월별 연도별 기온 분석 대시보드")
st.write(
    "사용자가 선택한 월의 전체 연도별 최고 기온과 최저 기온 변화를 시각화합니다."
)


# 데이터 로드 함수 (캐싱 적용)
@st.cache_data
def load_data():
  # 한글 깨짐 방지를 위해 cp949 인코딩 사용
  df = pd.read_csv("temperature.csv", encoding="cp949")
  df.columns = df.columns.str.strip()

  # '일시' 컬럼(예: 'Oct-07', 'Nov-07')을 파싱하여 연도와 월 추출
  years = []
  months = []
  for val in df["일시"]:
    try:
      dt = datetime.datetime.strptime(val.strip(), "%b-%y")
      year = dt.year
      # 2자리 연도 파싱 보정 (2026년 기준 50 이상은 1900년대)
      if year > 2026:
        year -= 100
      years.append(year)
      months.append(dt.month)
    except:
      years.append(None)
      months.append(None)

  df["연도"] = years
  df["월"] = months
  return df


# 데이터 불러오기
try:
  df = load_data()
except Exception as e:
  st.error(
    f"데이터 파일을 불러오는 중 오류가 발생했습니다. 'temperature.csv' 파일이 존재하는지 확인해주세요. 오류: {e}"
  )
  st.stop()

# 사이드바 설정: 월 선택
st.sidebar.header("⚙️ 분석 설정")
month_names = {
    1: "1월",
    2: "2월",
    3: "3월",
    4: "4월",
    5: "5월",
    6: "6월",
    7: "7월",
    8: "8월",
    9: "9월",
    10: "10월",
    11: "11월",
    12: "12월",
}

selected_month_num = st.sidebar.selectbox(
    "분석할 월을 선택하세요:",
    options=list(month_names.keys()),
    format_func=lambda x: month_names[x],
)

# 선택된 월 데이터 필터링
filtered_df = (
    df[df["월"] == selected_month_num].sort_values("연도").dropna(subset=["연도"])
)

# 메인 화면 구성
st.subheader(f"📅 [{month_names[selected_month_num]}] 연도별 기온 추이")

if filtered_df.empty:
  st.warning("선택된 월에 해당하는 데이터가 없습니다.")
else:
  # 맷플롯립 그래프 생성
  fig, ax = plt.subplots(figsize=(10, 5))

  # 최고기온: 핫핑크 (#FF69B4), 최저기온: 하늘색 (#87CEEB)
  ax.plot(
      filtered_df["연도"],
      filtered_df["최고기온(℃)"],
      label="최고기온",
      color="hotpink",
      marker="o",
      linewidth=2,
  )
  ax.plot(
      filtered_df["연도"],
      filtered_df["최저기온(℃)"],
      label="최저기온",
      color="skyblue",
      marker="s",
      linewidth=2,
  )

  # 그래프 제목 및 축 이름 설정 (한글 폰트 깨짐 방지를 위한 기본 설정)
  plt.rcParams["font.family"] = "sans-serif"
  plt.rcParams["axes.unicode_minus"] = False

  ax.set_title("월별 기온분석", fontsize=14, fontweight="bold", pad=15)
  ax.set_xlabel("연도", fontsize=12)
  ax.set_ylabel("온도 (℃)", fontsize=12)

  # 범례 표시 및 그리드 추가
  ax.legend(loc="upper left", frameon=True)
  ax.grid(True, linestyle="--", alpha=0.5)

  # 스트림릿에 그래프 출력
  st.pyplot(fig)

  # 데이터 요약 테이블 제공
  with st.expander("📊 선택된 월의 상세 데이터 테이블 보기"):
    display_df = filtered_df[
        ["연도", "평균기온(℃)", "최고기온(℃)", "최고기온일자", "최저기온(℃)", "최저기온일자"]
    ]
    st.dataframe(display_df.reset_index(drop=True), use_container_width=True)
